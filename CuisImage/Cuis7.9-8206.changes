!methodRemoval: Utf8EncodedWriteStream #pastEndPutByte: stamp: 'jmv 18/Sep/2026, 8:36:08 pm (UTC)'!
pastEndPutByte: aByte
	"Grow the collection.
	Then we put <anObject> at the current write position."

	self growTo: collection size + 1.
	collection at: (position := position + 1) put: aByte!

