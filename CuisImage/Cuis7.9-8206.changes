!classDefinition: #StaticImageMorph category: #'Morphic-Widgets' stamp: 'jmv 18/Sep/2026, 8:36:06 pm (UTC)'!
BorderedBoxMorph subclass: #StaticImageMorph
	instanceVariableNames: 'image scaledImage'
