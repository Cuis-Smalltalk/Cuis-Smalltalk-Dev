!AdditionalMethodState methodsFor: 'properties' stamp: 'jmv 23/Jul/2026, 2:53:50 pm (UTC)'!
                     propertyOrPragmaAt: aKey
	"Answer the element (property or pragma) associated with aKey.
	Answer nil if not found."

	| propertyOrPragma "<Association|ReadOnlyVariableBinding|Pragma>" |
	1 to: self basicSize do: [:i |
		propertyOrPragma := self basicAt: i.
		propertyOrPragma key == aKey ifTrue:
			[^propertyOrPragma]].
	^nil! !
!CompiledMethod methodsFor: 'accessing-pragmas & properties' stamp: 'jmv 23/Jul/2026, 2:58:37 pm (UTC)' prior: 16835996!
                             removeProperty: propName
	"Remove the property propName if it exists.
	 Do _not_ raise an error if the property is missing."

	self
		withPropertiesDo: [ :properties |
			(properties propertyOrPragmaAt: propName) ifNotNil: [ :property |
				self penultimateLiteral: (properties copyWithout: property) ]]
		ifSelector: [ :selector | ].! !
!CompiledMethod methodsFor: 'accessing-pragmas & properties' stamp: 'jmv 23/Jul/2026, 4:26:49 pm (UTC)' prior: 16836010!
                     removeProperty: propName ifAbsent: aBlock
	"Remove the property propName if it exists.
	 Do _not_ raise an error if the property is missing."

	self
		withPropertiesDo: [ :properties |
			(properties propertyOrPragmaAt: propName)
				ifNotNil: [ :property |
					self penultimateLiteral: (properties copyWithout: property) ]
				ifNil: [ aBlock value ]]
		ifSelector: [ :selector | aBlock value ].! !
!AdditionalMethodState methodsFor: 'copying' stamp: 'jmv 23/Jul/2026, 3:08:47 pm (UTC)' prior: 16780953!
      copyWithout: aPropertyOrPragma "<Association|Pragma>"
	"Answer a copy of the receiver which no longer includes aPropertyOrPragma
	if not found, answer self."
	| bs copy offset |
	copy := self class new: (bs := self basicSize) - 1.
	offset := 0.
	1 to: bs do:
		[ :i |
		(self basicAt: i) == aPropertyOrPragma
			ifTrue: [offset := 1]
			ifFalse: [copy basicAt: i - offset put: (self basicAt: i)]].
	offset = 1
		ifTrue: [ 
			^copy
				selector: selector;
				setMethod: method;
				yourself ]
		ifFalse: [ ^self ].! !

----End fileIn of /Users/juanvuletich/Cuis-Smalltalk/Cuis-Smalltalk-Dev/CoreUpdates/8081-MethodProperties-refactor-JuanVuletich-2026Jul23-12h51m-jmv.001.cs.st----!

'From Cuis7.9 [latest update: #8080] on 23 July 2026 at 1:33:05 pm'!
!CompiledMethod methodsFor: 'accessing-pragmas & properties' stamp: 'jmv 23/Jul/2026, 3:18:32 pm (UTC)' prior: 16835959!
                     propertyValueAt: propName put: propValue
	"Set or add the property with key propName and value propValue.
	 If the receiver does not yet have a method properties create one and replace
	 the selector with it.  Otherwise, either relace propValue in the method properties
	 or replace method properties with one containing the new property."
	
	self 
		withPropertiesDo: [ :properties |
			(properties propertyOrPragmaAt: propName)
				ifNotNil: [ :propertyOrPragma |
					propertyOrPragma isVariableBinding
						ifTrue: [ propertyOrPragma value: propValue ]
						ifFalse: [ self error: 'I already have a Pragma with requested name' ]]
				ifNil: [
					self penultimateLiteral: (properties
						copyWith: (Association
							key: propName asSymbol
							value: propValue))].
			^propValue ] 
		ifSelector: [ :selector |
			self penultimateLiteral: ((AdditionalMethodState
									selector: selector
									with: (Association
											key: propName asSymbol
											value: propValue))
									setMethod: self;
									yourself).
			^propValue].! !

AdditionalMethodState removeSelector: #includesProperty:!

!methodRemoval: AdditionalMethodState #includesProperty: stamp: 'jmv 24/Jul/2026, 12:55:58 pm (UTC)'!
includesProperty: aKey
	"Test if the property aKey is present."

	| propertyOrPragma "<Association|Pragma>" |
	1 to: self basicSize do: [:i |
		propertyOrPragma := self basicAt: i.
		(propertyOrPragma isVariableBinding
		 and: [propertyOrPragma key == aKey]) ifTrue:
			[^true]].
	^false!

----End fileIn of /Users/juanvuletich/Cuis-Smalltalk/Cuis-Smalltalk-Dev/CoreUpdates/8082-CompiledMethod-fix-JuanVuletich-2026Jul23-13h30m-jmv.001.cs.st----!

