'From Cuis7.9 [latest update: #8146] on 23 August 2026 at 7:34:39 pm'!
!NodesInRangeFinder methodsFor: 'evaluating' stamp: 'JEC 23/Aug/2026, 9:56:36 pm (UTC)' prior: 16925521!
value
	
	| nodeAtLastPositionFound |

	"Because some nodes have many ranges, like the literal nodes, we count the time we pass by a node that is equivalent
	to the index in the source ranges collection. sourceRangeIndexByNode is used to count per node - Hernan"
	sourceMethodNode := sourceMethod notOptimizedMethodNode.
	sourceCode := sourceMethod sourceCode.
	statements := OrderedCollection new.
	sourceRangeIndexByNode := IdentityBag new.
	firstNodeFound := false.

	sourceMethodNode nodesDo: [ :aNode | | nodeRange |
		sourceRangeIndexByNode add: aNode.
		nodeRange := self completeSourceRangeOf: aNode.
		nodeAtLastPositionFound := self ifInsideRangeAddToStatements: aNode locatedAt: nodeRange.
		nodeAtLastPositionFound ifTrue: [ ^statements ]].
			
	self signalNodesNotFound
	! !

----End fileIn of /Users/juanvuletich/Cuis-Smalltalk/Cuis-Smalltalk-Dev/CoreUpdates/8154-Refactoring-fix-JoelEstebanCamera-2026Aug23-18h55m-JEC.001.cs.st----!

'From Cuis7.9 [latest update: #8147] on 24 August 2026 at 6:32:05 pm'!
!ExtractMethodApplier methodsFor: 'refactoring - parameters request' stamp: 'JEC 24/Aug/2026, 9:31:38 pm (UTC)' prior: 50343397!
    requestNewMessageWithAllParameterizedValues

	| parseNodesToParameterized renameMeArguments |

	self initializeNewMessageArguments.
	
	parseNodesToParameterized := self parseAndParameterizableNodesToParameterizeInOrder.
	
	renameMeArguments := parseNodesToParameterized withIndexCollect: [ :node :index | 
		(node isVariableNode and: [ node isInstanceVariableNode not ])
			ifTrue: [ node ]
			ifFalse: [ VariableNode named: 'aRenameMe' , index asString ] ].

	^ self 
		requestNewMessageFor: parseNodesToParameterized 
		usingForSaving: renameMeArguments.! !

