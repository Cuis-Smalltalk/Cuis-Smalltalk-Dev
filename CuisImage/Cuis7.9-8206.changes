'From Cuis7.9 [latest update: #8184] on 17 September 2026 at 1:02:32 pm'!
!PushUpInstanceVariable methodsFor: 'applying - private' stamp: 'HAW 17/Sep/2026, 3:10:42 pm (UTC)'!
                removeInstanceVariableFrom: aSubclass

	"The class builder does not let the root class declare the variable while a subclass does, so
	the methods using it are compiled with it undeclared until adding it to the root class compiles
	them again. Resuming with false keeps the name out of Undeclared."

	[ aSubclass removeInstVarName: instanceVariableToMove ]
		on: UndeclaredVariableWarning
		do: [ :warning |
			warning variableName = instanceVariableToMove
				ifTrue: [ warning resume: false ]
				ifFalse: [ warning pass ]].
	changes add: aSubclass! !
!PushUpInstanceVariable methodsFor: 'applying - private' stamp: 'HAW 17/Sep/2026, 3:10:42 pm (UTC)' prior: 50357295!
 removeInstanceVariableFromAllSubclasses

	rootClass allSubclasses
		select: [ :subclass | subclass definesInstanceVariableNamed: instanceVariableToMove ]
		thenDo: [ :subclass | self removeInstanceVariableFrom: subclass ]! !

----End fileIn of /Users/juanvuletich/Cuis-Smalltalk/Cuis-Smalltalk-Dev/CoreUpdates/8204-PushUpInstVarWarning-HernanWilkinson-2026Sep16-19h43m-HAW.001.cs.st----!

'From Cuis7.9 [latest update: #8184] on 17 September 2026 at 1:16:29 pm'!
!TransferInstanceVariable methodsFor: 'applying - private' stamp: 'HAW 17/Sep/2026, 4:07:58 pm (UTC)'!
          removeInstanceVariableFrom: aClass

	"The class builder does not let a class declare the variable while another of its hierarchy does,
	so the methods using it are compiled with it undeclared until declaring it where it goes compiles
	them again. Resuming with false keeps the name out of Undeclared."

	[ aClass removeInstVarName: instanceVariableToMove ]
		on: UndeclaredVariableWarning
		do: [ :warning |
			warning variableName = instanceVariableToMove
				ifTrue: [ warning resume: false ]
				ifFalse: [ warning pass ]]! !
!PushDownInstanceVariable methodsFor: 'applying - private' stamp: 'HAW 17/Sep/2026, 4:07:58 pm (UTC)' prior: 50357282!
                        removeInstanceVariable

	self removeInstanceVariableFrom: classToRefactor! !
!PushUpInstanceVariable methodsFor: 'applying - private' stamp: 'HAW 17/Sep/2026, 4:07:58 pm (UTC)' prior: 50363749!
                              removeInstanceVariableFromAllSubclasses

	rootClass allSubclasses
		select: [ :subclass | subclass definesInstanceVariableNamed: instanceVariableToMove ]
		thenDo: [ :subclass |
			self removeInstanceVariableFrom: subclass.
			changes add: subclass ]! !

PushUpInstanceVariable removeSelector: #removeInstanceVariableFrom:!

!methodRemoval: PushUpInstanceVariable #removeInstanceVariableFrom: stamp: 'jmv 18/Sep/2026, 8:36:09 pm (UTC)'!
removeInstanceVariableFrom: aSubclass

	"The class builder does not let the root class declare the variable while a subclass does, so
	the methods using it are compiled with it undeclared until adding it to the root class compiles
	them again. Resuming with false keeps the name out of Undeclared."

	[ aSubclass removeInstVarName: instanceVariableToMove ]
		on: UndeclaredVariableWarning
		do: [ :warning |
			warning variableName = instanceVariableToMove
				ifTrue: [ warning resume: false ]
				ifFalse: [ warning pass ]].
	changes add: aSubclass!

